# Copy to .env (gitignored). No secrets here, ever. Missing key => offline stub, never a crash.

# --- run modes (ARCHITECTURE 12) ---
INPUT_MODE=scripted          # scripted | ptt (the per-call input_mode in POST /api/call/start wins)
APP_MODE=semi                # semi (scripted beat machine, offline) | live (Lyzr scammer, falls back to beats)
PACING_SPEED=1.0             # 0 = no waits (run10), 1.0 = real time

# --- access (C7) ---
APP_PASSCODE=                # unset => an ephemeral dev passcode is printed at startup
INTERNAL_TOKEN=              # >= 32 random bytes; unset => random per process
KILL_SWITCH=false
MAX_TURNS=30
MAX_CALL_SECONDS=300
START_RATE_PER_MIN=12
PTT_IDLE_S=60
DEMO_SYNTHETIC_ONLY=true

# --- paths ---
FIXTURES_PATH=fixtures/synthetic.sample.json
DB_PATH=data/saarthi.db
DATA_DIR=data
AUDIO_CACHE_DIR=audio/cache

# --- Lyzr (text agents; missing key => canned Kamla lines + semi scammer) ---
LYZR_API_KEY=
LYZR_USER_ID=
LYZR_CHAT_URL=https://agent-prod.studio.lyzr.ai/v3/inference/chat/
LYZR_AGENT_SCAMMER=
LYZR_AGENT_KAMLA=
LYZR_AGENT_INTEL=
KAMLA_TIMEOUT_S=6
SCAMMER_TIMEOUT_S=8

# --- TTS (catalog voices only, G2; missing/unavailable => no audio, durations estimated) ---
TTS_PROVIDER=                # kokoro (local Kokoro-82M, Apache-2.0; needs `pip install kokoro torch soundfile` + models/kokoro-82m) | elevenlabs | empty = stub
TTS_API_KEY=                 # elevenlabs only
TTS_VOICE_SCAMMER=           # kokoro: empty => hm_psi (the only allowed scammer voice)
TTS_VOICE_KAMLA=             # kokoro: empty => hf_beta (the only allowed Kamla voice); any other id is rejected
KOKORO_MODEL_DIR=models/kokoro-82m   # holds config.json, kokoro-v1_0.pth, voices/*.pt (gitignored)
KOKORO_DEVICE=auto           # auto (cuda if present) | cuda | cpu; CPU is ~3.7 s/line, GPU ~0.4 s. Pre-render: python tools/prerender_tts.py

# --- Band (missing key => band events still emitted with mirrored=false) ---
BAND_ENABLED=true
BAND_API_URL=https://app.band.ai/api/v1/agent
BAND_ROOM_ID=
BAND_KEY_SAARTHI=
BAND_KEY_DETECTOR=
BAND_KEY_KAMLA=
BAND_KEY_INTEL=
BAND_KEY_VERIFIER=
BAND_KEY_REPORTER=
BAND_AGENT_ID_REPORTER=
REPORTER_FALLBACK_S=20

# --- AdaL narrative (off => template narrative) ---
ADAL_ENABLED=false
# ADAL_BIN: PATH name or a full path, e.g. C:\Users\<you>\.adal\bin\adal.cmd (the Windows installer does not add it to PATH)
ADAL_BIN=adal
# ADAL_MODEL: AdaL model registry key (-m); empty = the CLI's configured default (e.g. a local Ollama model)
ADAL_MODEL=
ADAL_TIMEOUT_S=90
ADAL_PROVIDER_KEY=
# ADAL_ALLOWED_HOST: comma-separated egress allow-list for the AdaL subprocess (G3 proxy, port 443 only).
# Hosts the CLI contacts: adal.sylph.ai (API), clerk.adal.sylph.ai (auth). d35qg8ac0yw4p7.cloudfront.net is a
# non-essential CDN call (leave denied). Local Ollama (localhost:11434) bypasses the proxy via NO_PROXY.
ADAL_ALLOWED_HOST=

# --- Finch skill scout (off => local snapshot; set true to query the live catalogue) ---
FINCH_ENABLED=false
FINCH_SEARCH_URL=https://www.finchtech.ai/api/market/search

# --- DetectifAI voice flag (missing key => flag=false, source stub:not_checked) ---
DETECTIFAI_ENABLED=true
DETECTIFAI_API_KEY=

# --- Agent37 hosting (optional). Set to your deployed container URL; preflight --online GETs {url}/api/health ---
# e.g. https://<id>.agent37.app  (no trailing slash needed)
AGENT37_URL=

# --- Lyzr per-turn latency budget in seconds (preflight S1 gate, founder decision 3.5) ---
LYZR_TURN_BUDGET_S=3.5

# --- egress (C1): extra allowed hosts, comma separated, on top of the built-in sponsor hosts ---
EGRESS_ALLOWLIST=
